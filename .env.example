NODE_ENV=development
# Production: set per deployment (e.g. git SHA) to enable immutable fingerprinted asset URLs
BUILD_ID=
PORT=5555
APP_URL=http://localhost:5555

# Required outside test. Generate with: openssl rand -hex 32
SESSION_SECRET=

# SQLite file (relative to project root)
DATABASE_FILE=./db/velix.sqlite

# Optional: Google OAuth (leave blank to disable /google/* routes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Resend transactional email (leave blank to log emails to console)
RESEND_API_KEY=
MAIL_FROM=Velix <noreply@example.com>
