{
  "name": "volt",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "High-performance full-stack TypeScript framework on Remix 3.1, recreated from laravolt/laju.",
  "scripts": {
    "dev": "NODE_ENV=development node --watch --import remix/node-tsx server.ts",
    "hmr": "NODE_ENV=development node hmr.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "css": "tailwindcss -i ./app/styles/app.css -o ./public/app.css --minify",
    "css:watch": "tailwindcss -i ./app/styles/app.css -o ./public/app.css --watch",
    "predev": "npm run css",
    "prestart": "npm run css",
    "migrate": "node --import remix/node-tsx app/data/migrate.ts up",
    "migrate:down": "node --import remix/node-tsx app/data/migrate.ts down",
    "migrate:status": "node --import remix/node-tsx app/data/migrate.ts status",
    "test": "remix test",
    "typecheck": "tsc --noEmit",
    "routes": "remix routes --table",
    "doctor": "remix doctor"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "better-sqlite3": "12.8.0",
    "remix": "3.1.0",
    "volt-preline": "github:laravolt/volt-preline#v0.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/cli": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.5.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2"
  }
}
