{
  "$schema": "./node_modules/remix/schema/remix.json",
  "assets": {
    "rootDir": ".",
    "basePath": "/assets",
    "allowFiles": ["app/routes.ts", "app/**/public/**"],
    "allowPackages": ["remix", "volt-preline"],
    "denyFiles": ["app/**/*.test.*"]
  },
  "db": {
    "adapter": {
      "type": "sqlite",
      "filename": { "env": "DATABASE_FILE", "default": "./db/volt.sqlite" },
      "foreignKeys": true,
      "busyTimeout": 5000
    },
    "migrations": {
      "directory": "./db/migrations",
      "journalTable": "volt_migrations"
    }
  },
  "test": {
    "files": ["test/**/*.test.{ts,tsx}", "test/**/*.test.e2e.{ts,tsx}"],
    "exclude": ["node_modules/**", "tmp/**"],
    "type": ["server"]
  }
}
